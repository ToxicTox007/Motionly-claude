{
  "name": "motionly",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --check .",
    "perf:k6": "k6 run scripts/perf/k6-api-workflows.js",
    "perf:bullmq": "node scripts/perf/bullmq-queue-load.mjs",
    "perf:browser": "pnpm --filter @motionly/web perf:browser",
    "perf:media": "node scripts/perf/media-golden-benchmarks.mjs",
    "perf:slo:check": "node scripts/perf/assert-slo.mjs",
    "contracts:generate": "pnpm --filter @motionly/shared contracts:generate",
    "contracts:check": "pnpm --filter @motionly/shared contracts:check",
    "audit:local": "python apps/api/scripts/audit_local_topology.py --plan-only",
    "audit:local:preflight": "python apps/api/scripts/audit_local_capabilities.py --plan-only"
  },
  "devDependencies": {
    "pg": "8.21.0",
    "prettier": "3.8.3",
    "supabase": "2.104.0",
    "turbo": "2.9.16",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "postcss@<8.5.10": "8.5.10",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
