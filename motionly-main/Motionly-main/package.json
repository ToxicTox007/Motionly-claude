{
  "name": "motionly",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --check .",
    "docs:check": "node scripts/check_docs.mjs",
    "verify": "node scripts/verify/verify.mjs",
    "perf:k6": "k6 run scripts/perf/k6-api-workflows.js",
    "perf:bullmq": "node scripts/perf/bullmq-queue-load.mjs",
    "perf:browser": "pnpm --filter @motionly/web perf:browser",
    "perf:media": "node scripts/perf/media-golden-benchmarks.mjs",
    "perf:slo:check": "node scripts/perf/assert-slo.mjs",
    "contracts:generate": "pnpm --filter @motionly/shared contracts:generate",
    "contracts:check": "pnpm --filter @motionly/shared contracts:check",
    "audit:local": "python apps/api/scripts/audit_local_topology.py --plan-only",
    "audit:local:preflight": "python apps/api/scripts/audit_local_capabilities.py --plan-only"
  },
  "devDependencies": {
    "knip": "6.42.1",
    "pg": "8.21.0",
    "prettier": "3.8.3",
    "supabase": "2.104.0",
    "turbo": "2.9.16",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "baseline-browser-mapping@<2.11.31": "2.11.31",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "browserslist@<4.29.4": "4.29.4",
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@>=3.0.0 <3.3.20": "3.3.20",
      "postcss-selector-parser@<7.1.7": "7.1.7",
      "postcss@<8.5.31": "8.5.31",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
