# Shared runtime
APP_ENV=production
LOG_LEVEL=INFO

# API runtime
API_CORS_ORIGINS=https://your-app.example.com
API_PUBLIC_BASE_URL=https://your-api.example.com

# Supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Storage and rendering
UPLOAD_STORAGE_BUCKET=raw-uploads
UPLOAD_MAX_FILE_SIZE_BYTES=536870912
UPLOAD_MAX_CONCURRENT_PER_WORKSPACE=3
UPLOAD_SIGNED_URL_TTL_SECONDS=900
EXPORT_STORAGE_BUCKET=exports
EXPORT_SIGNED_URL_TTL_SECONDS=300
RETENTION_SOURCE_DAYS=365
RETENTION_GENERATED_ASSET_DAYS=90
RETENTION_TRANSCRIPT_DAYS=365
RETENTION_ANALYTICS_DAYS=365
RETENTION_EXPORT_DAYS=30
RETENTION_LOCAL_CACHE_DAYS=7
MEDIA_WORK_DIR=/var/data/motionly/storage
RENDER_EXECUTE_FFMPEG=true
RENDER_TEMP_DIR=/var/data/motionly/render-tmp
FFMPEG_GPU_ENABLED=false
FFMPEG_GPU_ENCODER=h264_nvenc
STEM_SEPARATION_PROVIDER=demucs
# The Demucs model id/revision come from the registry local route (cpu-local.json).
# A remote stem-separation provider is configured through an audio.stem_separation
# registry route (plan Task 17), not an env switch.

# Queue (BullMQ over Redis)
REDIS_URL=redis://default:replace-with-password@your-redis.example.com:6379

# Durable workflow orchestration. Required in production only when PROCESS_ROLE is
# temporal-dispatcher, temporal-worker, or workflow-reconciler.
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.your-account
TEMPORAL_API_KEY=replace-with-temporal-api-key
TEMPORAL_TASK_QUEUE=motionly-workflows
TEMPORAL_TLS_ENABLED=true
# Self-hosted production requires all fields below and an identity that matches
# the mounted certificate common name. Cloud deployments may leave them unset.
TEMPORAL_SERVER_ROOT_CA_PATH=/run/secrets/temporal_ca_cert
TEMPORAL_CLIENT_CERT_PATH=/run/secrets/temporal_api_cert
TEMPORAL_CLIENT_PRIVATE_KEY_PATH=/run/secrets/temporal_api_key
TEMPORAL_SERVER_NAME=temporal
TEMPORAL_CLIENT_ROLE=api
TEMPORAL_IDENTITY=motionly-api
WORKFLOW_DISPATCHER_BATCH_SIZE=25
WORKFLOW_DISPATCHER_LEASE_SECONDS=60
WORKFLOW_DISPATCHER_POLL_INTERVAL_SECONDS=1
WORKFLOW_DISPATCHER_BACKOFF_INITIAL_SECONDS=1
WORKFLOW_DISPATCHER_BACKOFF_MAX_SECONDS=60
WORKFLOW_RECONCILER_INTERVAL_SECONDS=30
WORKFLOW_RECONCILER_STALENESS_SECONDS=300
WORKFLOW_RECONCILER_BATCH_SIZE=50
WORKFLOW_STEP_LEASE_SECONDS=3600
WORKFLOW_STEP_RESULT_MAX_BYTES=262144

JOB_ATTEMPTS=3
JOB_BACKOFF_MS=30000
JOB_STALLED_INTERVAL_MS=30000
WORKER_CONCURRENCY=3
RENDER_WORKER_CONCURRENCY=1
GPU_RENDER_WORKER_CONCURRENCY=1
BULLMQ_NODE_COMMAND=node
BULLMQ_BRIDGE_PATH=

# Static Compose GPU worker capacity. Replica counts match the dedicated worker
# services in infra/docker-compose.gpu.yml; deployment changes are release-managed.
GPU_POOL_VISUAL_REPLICAS=1
GPU_POOL_MATTE_REPLICAS=1
GPU_POOL_RENDER_REPLICAS=1

# Provider-neutral model gateway. Routes come only from the declarative registry
# (plan Task 26); there is no env-JSON route list and no vendor endpoint env
# variables. OpenAI-compatible and Azure endpoints are declared in the registry
# file.
MODEL_GATEWAY_ENABLED=true
MODEL_GATEWAY_MONTHLY_BUDGET_USD=100
MODEL_GATEWAY_REQUEST_BUDGET_USD=5
# Optional deployment-wide monthly caps per feature (JSON object, USD); omitted
# features are uncapped. Example: {"vision_captions":20,"audio_stems":15}
MODEL_GATEWAY_FEATURE_BUDGETS_USD=
# Per-plan monthly quotas for remote AI features (remote routes only), named
# QUOTA_<FEATURE>_<PLAN>_LIMIT_<UNIT>; see app.services.billing.FEATURE_QUOTAS
# for features, units and defaults. Example: QUOTA_AUDIO_STEMS_FREE_LIMIT_SECONDS=600
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_CIRCUIT_COOLDOWN_SECONDS=60
# Declarative inference registry (plan Task 4/Task 26): the only source of
# inference routes. A comma-separated list composes a remote registry with the
# local fragments (infra/ai-registry/cpu-local.json, gpu-local.json).
AI_REGISTRY_FILE=/opt/motionly/ai-registry/registry.json
AI_BLOCK_NONCOMMERCIAL=false
AI_WORKSPACE_SCOPED_ROUTES=false
AI_SECRETS_DIR=/run/secrets
AI_SECRETS_BUNDLE_FILE=/run/secrets/ai_secrets_bundle
AI_QUOTA_SCOPE=feature

# The transcription and planning model ids/revisions, credentials and provider
# labels all come from the registry (the gateway route's provider, or a neutral
# "gateway" label); only the budget hints stay as settings.
TRANSCRIPTION_ESTIMATED_COST_PER_REQUEST_USD=0.25
TRANSCRIPTION_DEBUG_RETAIN_AUDIO=false
ALLOW_FIXTURE_PROVIDERS=false
EDIT_PLANNER_INPUT_COST_PER_MILLION_USD=2
EDIT_PLANNER_OUTPUT_COST_PER_MILLION_USD=2

AUDIO_ML_PROVIDER=local_ml
# Per-feature audio switches (empty = follow AUDIO_ML_PROVIDER). A remote
# diarization provider is configured through an audio.diarization registry route
# (plan Task 17), not an env switch.
AUDIO_DIARIZATION_PROVIDER=
AUDIO_EMOTION_PROVIDER=
AUDIO_SOUND_PROVIDER=
YAMNET_TFLITE_MODEL_PATH=/opt/motionly/models/yamnet.tflite
YAMNET_TFLITE_MODEL_SHA256=4d8b4a53282dc83ef04e3e7dbc4fbc98082e34e44ed798e16c3a0cdd4c584faf
CPU_VISION_ENABLED=false
# false: GPU-free deployment (no GPU workers; every feature on a CPU/remote provider).
GPU_WORKERS_ENABLED=true
MATTE_PROVIDER=local_ml
MATTE_CPU_MODEL_PATH=/opt/motionly/models/selfie_segmenter_landscape.tflite
MATTE_CPU_MODEL_SHA256=490e9ea734313e0de10fa0cd9e3c6133e36ea4db2b7a49bde9ef019f72796b8e
VISUAL_CPU_FACE_MODEL_PATH=/opt/motionly/models/blaze_face_full_range.tflite
VISUAL_CPU_FACE_MODEL_SHA256=3698b18f063835bc609069ef052228fbe86d9c9a6dc8dcb7c7c2d69aed2b181b
VISUAL_REMOTE_MAX_KEYFRAMES=24
# Keyframe object detection is enabled by a vision.object_detection registry
# route (plan Task 17), not an env switch.
# Keyframe captions become a registry capability route in Tier 2 (plan Task 11);
# there is no vendor caption switch.
# The local CLIP/BLIP/YOLO/pyannote/wav2vec2/Demucs model ids and revisions come
# from the registry local routes (gpu-local.json, cpu-local.json), not here.
# Keyframe and B-roll embeddings become a registry capability route in Tier 2
# (plan Task 12); there is no vendor embeddings env setting.

STOCK_VIDEO_PROVIDER=pexels_pixabay
PEXELS_API_KEY=replace-with-pexels-api-key
PIXABAY_API_KEY=replace-with-pixabay-api-key
MUSIC_PROVIDER=licensed_catalog
LICENSED_MUSIC_CATALOG_TABLE=licensed_music_tracks

# Admin, billing, and observability
RATE_LIMIT_PER_MINUTE=120
# Unauthenticated public endpoints, per viewer address and overall, per hour.
FEEDBACK_RATE_LIMIT_PER_HOUR=10
FEEDBACK_GLOBAL_RATE_LIMIT_PER_HOUR=500
PUBLIC_REVIEW_RATE_LIMIT_PER_HOUR=240
PUBLIC_REVIEW_GLOBAL_RATE_LIMIT_PER_HOUR=10000
ADMIN_API_TOKEN=replace-with-distinct-admin-token
WORKER_API_TOKEN=replace-with-distinct-worker-token
ADMIN_USER_IDS=
# ADMIN_WORKSPACE_IDS: owners and admins of these workspaces are platform admins
# (plain members are not). Prefer ADMIN_USER_IDS for named operators.
ADMIN_WORKSPACE_IDS=
BILLING_ENABLED=false
BILLING_MODE=disabled
# Days a past-due (failed renewal) subscription keeps paid features, counted
# from the end of the paid period (0-60, default 7). After it, Free applies.
BILLING_PAST_DUE_GRACE_DAYS=7
# Payment gateway (demo mock gateway). Prices come from app/config/plans.json (INR).
MOCK_GATEWAY_BASE_URL=http://payment-gateway:8010
MOCK_GATEWAY_PUBLIC_BASE_URL=https://your-app.example.com
MERCHANT_API_KEY=
MOCK_GATEWAY_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://your-app.example.com/billing?checkout=success
BILLING_CANCEL_URL=https://your-app.example.com/pricing?checkout=cancel
