# Worker runtime
APP_ENV=production
PROCESS_ROLE=worker
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
REDIS_URL=redis://default:replace-with-password@your-redis.example.com:6379
SENTRY_DSN=replace-with-sentry-dsn
WORKER_API_BASE_URL=https://api.example.com
WORKER_API_TOKEN=replace-with-distinct-worker-token
PUBLISH_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=30000
JOB_STALLED_INTERVAL_MS=30000
WORKER_CONCURRENCY=3
RENDER_WORKER_CONCURRENCY=1
GPU_RENDER_WORKER_CONCURRENCY=1
# Comma-separated queue isolation. A GPU worker normally uses render_gpu,publish.
WORKER_QUEUES=
EXPORT_STORAGE_BUCKET=exports
REMOTION_ENABLED=false
RENDERER_BASE_PATH=/app/apps/renderer
BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
REMOTION_DISABLE_SANDBOX=true
RETENTION_CRON=0 3 * * *
