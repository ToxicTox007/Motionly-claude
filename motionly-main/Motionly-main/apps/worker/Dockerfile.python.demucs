FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    PROCESS_ROLE=worker \
    PYTHON_MEDIA_WORKER_ENABLED=true \
    PYTHON_MEDIA_CWD=/app \
    MODEL_PREFETCH=true \
    STEM_SEPARATION_PROVIDER=demucs \
    DEMUCS_MODEL=htdemucs \
    HF_HOME=/var/cache/motionly/huggingface \
    TORCH_HOME=/var/cache/motionly/torch \
    XDG_CACHE_HOME=/var/cache/motionly \
    MEDIA_WORK_DIR=/var/data/motionly/storage \
    RENDER_TEMP_DIR=/var/data/motionly/render-tmp \
    TMPDIR=/tmp/motionly \
    HOME=/home/motionly

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Node.js 24 LTS from the pinned official image (Decision D1); Debian's
# nodejs package is Node 20, which is past end of life.
COPY --from=node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 /usr/local/bin/node /usr/local/bin/node
COPY --from=node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version && npm --version

WORKDIR /app
COPY apps/api/pyproject.toml ./pyproject.toml
COPY apps/api/requirements-ml.lock ./requirements-ml.lock
COPY apps/api/app ./app
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/worker/package-lock.json ./apps/worker/package-lock.json
COPY apps/worker/src ./apps/worker/src

RUN cd apps/worker && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && pip install --no-cache-dir --require-hashes -r /app/requirements-ml.lock

RUN useradd --create-home --uid 10001 motionly \
    && mkdir -p /var/cache/motionly/huggingface \
        /var/cache/motionly/torch \
        /var/data/motionly/storage \
        /var/data/motionly/render-tmp \
        /tmp/motionly \
    && chown -R motionly:motionly /home/motionly /app /var/cache/motionly /var/data/motionly /tmp/motionly
WORKDIR /app/apps/worker
USER motionly
CMD ["sh", "-c", "cd /app && python -m app.workers.prefetch_models && cd /app/apps/worker && node src/worker.mjs --loop"]
