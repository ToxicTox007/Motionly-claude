{
  "name": "@motionly/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file=.env src/worker.mjs --check",
    "dev": "node --env-file=.env src/worker.mjs --loop",
    "lint": "node --env-file=.env src/worker.mjs --check",
    "start": "node --env-file=.env src/worker.mjs --loop",
    "typecheck": "node --env-file=.env src/worker.mjs --check",
    "test": "node --env-file=.env --test src/*.test.mjs && node --env-file=.env src/worker.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.106.2",
    "bullmq": "5.78.0",
    "ioredis": "5.11.1"
  }
}
