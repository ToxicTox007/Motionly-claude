FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28

ARG API_EXTRAS=""
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    PROCESS_ROLE=worker \
    PYTHON_MEDIA_WORKER_ENABLED=true \
    HF_HOME=/var/cache/motionly/huggingface \
    TORCH_HOME=/var/cache/motionly/torch \
    XDG_CACHE_HOME=/var/cache/motionly \
    MEDIA_WORK_DIR=/var/data/motionly/storage \
    RENDER_TEMP_DIR=/var/data/motionly/render-tmp \
    TMPDIR=/tmp/motionly \
    HOME=/home/motionly

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg nodejs npm libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY apps/api/pyproject.toml ./pyproject.toml
COPY apps/api/requirements.lock ./requirements.lock
COPY apps/api/requirements-ml.lock ./requirements-ml.lock
COPY apps/api/app ./app
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/worker/package-lock.json ./apps/worker/package-lock.json
COPY apps/worker/src ./apps/worker/src

RUN cd apps/worker && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && if [ -n "$API_EXTRAS" ]; then pip install --no-cache-dir --require-hashes -r /app/requirements-ml.lock; \
       else pip install --no-cache-dir --require-hashes -r /app/requirements.lock; fi

RUN useradd --create-home --uid 10001 motionly \
    && mkdir -p /var/cache/motionly/huggingface \
        /var/cache/motionly/torch \
        /var/data/motionly/storage \
        /var/data/motionly/render-tmp \
        /tmp/motionly \
    && chown -R motionly:motionly /app /var/cache/motionly /var/data/motionly /tmp/motionly
WORKDIR /app/apps/worker
USER motionly
CMD ["sh", "-c", "cd /app && python -m app.workers.prefetch_models && cd /app/apps/worker && node src/worker.mjs --loop"]
