{
  "name": "@motionly/renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "remotion studio src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "render": "node --import ./ts-node-register.mjs src/render-cli.ts",
    "render:cli": "node --import ./ts-node-register.mjs src/render-cli.ts",
    "render:smoke": "node --import ./ts-node-register.mjs src/smoke-render.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && TS_NODE_TRANSPILE_ONLY=true node --import ./ts-node-register.mjs --test src/*.test.ts && node --test src/*.test.mjs",
    "test:encoded": "RUN_RENDERER_ENCODED_TESTS=true TS_NODE_TRANSPILE_ONLY=true node --import ./ts-node-register.mjs --test src/encoded-output.test.ts",
    "test:golden": "RUN_RENDERER_GOLDEN_TESTS=true TS_NODE_TRANSPILE_ONLY=true node --import ./ts-node-register.mjs --test src/golden-frames.test.ts"
  },
  "dependencies": {
    "@motionly/shared": "workspace:*",
    "@remotion/bundler": "4.0.431",
    "@remotion/cli": "4.0.431",
    "@remotion/renderer": "4.0.431",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.431"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
