# Motionly web environment. Read when the server starts, never at build time;
# browsers receive only the public values, embedded in each page.
APP_ENV=development
# The one public origin. Browsers reach the API at <origin>/api and Supabase at
# <origin>/supabase; `next dev` proxies both paths locally.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Private-network locations the server uses.
API_INTERNAL_URL=http://127.0.0.1:8000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Literal "true" or "false".
BILLING_ENABLED=false

# Server-only admin settings
ADMIN_API_TOKEN=replace-with-worker-and-admin-token
ADMIN_USER_IDS=
# ADMIN_WORKSPACE_IDS: owners and admins of these workspaces are platform admins
# (plain members are not). Prefer ADMIN_USER_IDS for named operators.
ADMIN_WORKSPACE_IDS=
