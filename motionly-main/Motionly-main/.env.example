# Shared runtime
APP_ENV=production
LOG_LEVEL=INFO

# One public origin: browsers reach the web app at <origin>/, the API at
# <origin>/api and Supabase at <origin>/supabase.
PUBLIC_ORIGIN=https://your-app.example.com

# Web runtime (read when the server starts, never at build time)
API_INTERNAL_URL=http://api:8000

# API runtime
API_CORS_ORIGINS=https://your-app.example.com
API_PUBLIC_BASE_URL=https://your-app.example.com/api
# Supabase as browsers reach it (signed media links).
SUPABASE_PUBLIC_URL=https://your-app.example.com/supabase

# Supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_PROJECT_REF=replace-with-supabase-project-ref
SUPABASE_POOLER_HOST=replace-with-supabase-pooler-host
SUPABASE_DB_PASSWORD=replace-with-supabase-db-password
SUPABASE_DATABASE_URL=

# Storage and rendering
UPLOAD_STORAGE_BUCKET=raw-uploads
UPLOAD_MAX_FILE_SIZE_BYTES=536870912
UPLOAD_MAX_CONCURRENT_PER_WORKSPACE=3
UPLOAD_SIGNED_URL_TTL_SECONDS=900
EXPORT_STORAGE_BUCKET=exports
EXPORT_SIGNED_URL_TTL_SECONDS=300
RETENTION_SOURCE_DAYS=365
RETENTION_GENERATED_ASSET_DAYS=90
RETENTION_TRANSCRIPT_DAYS=365
RETENTION_ANALYTICS_DAYS=365
RETENTION_EXPORT_DAYS=30
RETENTION_LOCAL_CACHE_DAYS=7
MEDIA_CACHE_MAX_BYTES=10737418240
RETENTION_CRON=0 3 * * *
MEDIA_WORK_DIR=/var/data/motionly/storage
RENDER_EXECUTE_FFMPEG=true
RENDER_TEMP_DIR=/var/data/motionly/render-tmp

# Queue (BullMQ over Redis)
REDIS_URL=redis://default:replace-with-password@your-redis.example.com:6379

# Durable workflow orchestration. Required in production only when PROCESS_ROLE is
# temporal-dispatcher, temporal-worker, or workflow-reconciler.
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.your-account
TEMPORAL_API_KEY=replace-with-temporal-api-key
TEMPORAL_TASK_QUEUE=motionly-workflows
TEMPORAL_TLS_ENABLED=true
WORKFLOW_DISPATCHER_BATCH_SIZE=25
WORKFLOW_DISPATCHER_LEASE_SECONDS=60
WORKFLOW_DISPATCHER_POLL_INTERVAL_SECONDS=1
WORKFLOW_DISPATCHER_BACKOFF_INITIAL_SECONDS=1
WORKFLOW_DISPATCHER_BACKOFF_MAX_SECONDS=60
WORKFLOW_RECONCILER_INTERVAL_SECONDS=30
WORKFLOW_RECONCILER_STALENESS_SECONDS=300
WORKFLOW_RECONCILER_BATCH_SIZE=50
WORKFLOW_STEP_LEASE_SECONDS=3600
WORKFLOW_STEP_RESULT_MAX_BYTES=262144

JOB_ATTEMPTS=3
JOB_BACKOFF_MS=30000
JOB_STALLED_INTERVAL_MS=30000
WORKER_CONCURRENCY=3
RENDER_WORKER_CONCURRENCY=1
BULLMQ_NODE_COMMAND=node
BULLMQ_BRIDGE_PATH=

# AI model gateway and provider routes
MODEL_GATEWAY_ENABLED=true
MODEL_GATEWAY_MONTHLY_BUDGET_USD=100
MODEL_GATEWAY_REQUEST_BUDGET_USD=5
# Optional deployment-wide monthly caps per feature (JSON object, USD). Features:
# planning, transcription, generation, embeddings, vision_objects, vision_captions,
# audio_diarization, audio_emotion, audio_stems. Omitted features are uncapped.
# Example: {"vision_captions":20,"audio_stems":15}
MODEL_GATEWAY_FEATURE_BUDGETS_USD=
# Per-plan monthly quotas for the remote AI features, per workspace (plans: free,
# creator, pro, agency). Metered only on remote routes; local GPU/CPU routes never
# count. Over quota, analysis degrades with quota_exceeded and stems return 402.
# QUOTA_<FEATURE>_<PLAN>_LIMIT_<UNIT>, defaults free/creator/pro/agency:
#   VISION_OBJECTS ... _IMAGES    120 / 1000 / 3000 / 7500
#   VISION_CAPTIONS ... _IMAGES   120 / 1000 / 3000 / 7500
#   EMBEDDINGS ... _INPUTS        1000 / 8000 / 24000 / 60000
#   AUDIO_DIARIZATION ... _SECONDS 1800 / 14400 / 43200 / 108000
#   AUDIO_EMOTION ... _SECONDS    1800 / 14400 / 43200 / 108000
#   AUDIO_STEMS ... _SECONDS      600 / 3600 / 10800 / 36000
# Example: QUOTA_VISION_CAPTIONS_FREE_LIMIT_IMAGES=60
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_CIRCUIT_COOLDOWN_SECONDS=60
# Declarative inference registry (plan Task 4/Task 26). The registry file is the
# only source of inference routes: adapters, models and routes (including any
# OpenAI-compatible or Azure endpoint) are declared there, never as vendor env
# variables. A comma-separated list composes a remote registry with the local
# fragments (infra/ai-registry/cpu-local.json, gpu-local.json).
AI_REGISTRY_FILE=/opt/motionly/ai-registry/registry.json
# Non-commercial licences are an error (not just a warning) when true.
AI_BLOCK_NONCOMMERCIAL=false
# Workspace-scoped (BYOK) routes stay rejected until this is turned on.
AI_WORKSPACE_SCOPED_ROUTES=false
# Generic inference secret storage. ``file:<name>`` refs read
# ``<AI_SECRETS_DIR>/<name>``; ``bundle:<key>`` refs read a key from the JSON
# object at AI_SECRETS_BUNDLE_FILE. Mounted read-only; never logged or returned.
AI_SECRETS_DIR=/run/secrets
AI_SECRETS_BUNDLE_FILE=/run/secrets/ai_secrets_bundle
# ``feature`` sums usage per Motionly feature across providers; ``provider``
# restores per-provider counting (removed at the Tier 2 gate).
AI_QUOTA_SCOPE=feature
# Keyframe and B-roll embeddings become a declarative registry capability route
# in Tier 2 (plan Task 12); there is no vendor embeddings env setting. Until a
# route is configured, B-roll ranking uses its lexical fallback.
# Vocal/instrumental stems: demucs (local GPU/CPU worker) or fixture (tests). A
# remote stem-separation provider is configured through an audio.stem_separation
# registry route (plan Task 17), not an env switch.
STEM_SEPARATION_PROVIDER=demucs

# The transcription model id/revision, credentials and provider label all come
# from the registry (the gateway route's provider, or a neutral "gateway"
# label); only the per-request budget hint stays as a setting.
TRANSCRIPTION_ESTIMATED_COST_PER_REQUEST_USD=0.25
TRANSCRIPTION_DEBUG_RETAIN_AUDIO=false
ALLOW_FIXTURE_PROVIDERS=false
AUDIO_ML_PROVIDER=local_ml
# Per-feature audio switches (empty = follow AUDIO_ML_PROVIDER). Speaker
# diarization: local_ml (pyannote on the ML worker) or disabled. A remote
# diarization provider is configured through an audio.diarization registry route
# (plan Task 17), not an env switch.
AUDIO_DIARIZATION_PROVIDER=
# Voice emotion: local_ml (wav2vec2 on the ML worker) or disabled. The remote
# voice-emotion path (model id, revision, pricing, windowing) is rebuilt as a
# registry capability route in Tier 2 (plan Task 12).
AUDIO_EMOTION_PROVIDER=
# Sound events: local_ml (TF Hub YAMNet on the ML worker), yamnet_tflite (YAMNet on
# CPU via MediaPipe in the cpu-vision image; real AudioSet labels), or disabled.
AUDIO_SOUND_PROVIDER=
YAMNET_TFLITE_MODEL_PATH=/opt/motionly/models/yamnet.tflite
YAMNET_TFLITE_MODEL_SHA256=4d8b4a53282dc83ef04e3e7dbc4fbc98082e34e44ed798e16c3a0cdd4c584faf
# Set automatically by the cpu-vision worker image (Dockerfile.python
# --build-arg API_EXTRAS=cpu-vision --build-arg CPU_VISION_ENABLED=true).
CPU_VISION_ENABLED=false
# false for a GPU-free deployment (infra/docker-compose.remote-ai.yml): no GPU
# capacity observer or GPU model prefetch, and production refuses any feature
# switch that still needs a GPU worker. true keeps the GPU topology.
GPU_WORKERS_ENABLED=true
# Background matte: local_ml (MediaPipe on the GPU/ML worker) or local_cpu
# (MediaPipe Tasks selfie segmenter on the cpu-vision worker; no GPU needed).
MATTE_PROVIDER=local_ml
MATTE_CPU_MODEL_PATH=/opt/motionly/models/selfie_segmenter_landscape.tflite
MATTE_CPU_MODEL_SHA256=490e9ea734313e0de10fa0cd9e3c6133e36ea4db2b7a49bde9ef019f72796b8e
# VISUAL_PROVIDER=remote: OpenCV/MediaPipe CPU signals on the cpu-vision worker
# plus remote objects/captions/embeddings on one keyframe per scene (capped).
VISUAL_CPU_FACE_MODEL_PATH=/opt/motionly/models/blaze_face_full_range.tflite
VISUAL_CPU_FACE_MODEL_SHA256=3698b18f063835bc609069ef052228fbe86d9c9a6dc8dcb7c7c2d69aed2b181b
VISUAL_REMOTE_MAX_KEYFRAMES=24
# Keyframe object detection is enabled by a vision.object_detection registry
# route (plan Task 17), not an env switch; the route supplies the model id,
# revision, pricing, batch limits and credentials. Objects are reported disabled
# until a route is configured.
# Keyframe captions become a registry capability route in Tier 2 (plan Task 11);
# there is no vendor caption switch. Keyframe embeddings become a registry
# capability route in Tier 2 (plan Task 12); there is no vendor embeddings switch.
# The planning model id/revision, credentials and provider label come from the
# registry (the gateway route's provider, or a neutral "gateway" label); only
# the budget hints stay as settings.
EDIT_PLANNER_INPUT_COST_PER_MILLION_USD=2
EDIT_PLANNER_OUTPUT_COST_PER_MILLION_USD=2
STOCK_VIDEO_PROVIDER=pexels_pixabay
PEXELS_API_KEY=replace-with-pexels-api-key
PIXABAY_API_KEY=replace-with-pixabay-api-key
MUSIC_PROVIDER=licensed_catalog
LICENSED_MUSIC_CATALOG_TABLE=licensed_music_tracks

# Admin, billing, and observability
RATE_LIMIT_PER_MINUTE=120
# Unauthenticated public endpoints, per viewer address and overall, per hour.
FEEDBACK_RATE_LIMIT_PER_HOUR=10
FEEDBACK_GLOBAL_RATE_LIMIT_PER_HOUR=500
PUBLIC_REVIEW_RATE_LIMIT_PER_HOUR=240
PUBLIC_REVIEW_GLOBAL_RATE_LIMIT_PER_HOUR=10000
ADMIN_API_TOKEN=replace-with-distinct-admin-token
WORKER_API_TOKEN=replace-with-distinct-worker-token
ADMIN_USER_IDS=
# ADMIN_WORKSPACE_IDS: owners and admins of these workspaces are platform admins
# (plain members are not). Prefer ADMIN_USER_IDS for named operators.
ADMIN_WORKSPACE_IDS=
# Read by the API and the web app; literal "true" or "false".
BILLING_ENABLED=false
# Deployment billing posture; production requires one of: disabled, demo.
BILLING_MODE=disabled
# Days a past-due (failed renewal) subscription keeps paid features, counted
# from the end of the paid period (0-60, default 7). After it, Free applies.
BILLING_PAST_DUE_GRACE_DAYS=7
# Payment gateway (demo mock gateway). Prices are read from
# apps/api/app/config/plans.json (INR), not from env.
# Internal URL the API uses to reach the gateway (server-to-server).
MOCK_GATEWAY_BASE_URL=http://payment-gateway:8010
# Browser-facing origin used to build the checkout page link.
MOCK_GATEWAY_PUBLIC_BASE_URL=https://your-app.example.com
# Shared merchant key (Bearer) the API presents to the gateway.
MERCHANT_API_KEY=
# HMAC secret the API uses to verify gateway webhooks.
MOCK_GATEWAY_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://your-app.example.com/billing?checkout=success
BILLING_CANCEL_URL=https://your-app.example.com/pricing?checkout=cancel
METRICS_BEARER_TOKEN=replace-with-long-random-metrics-token
OTEL_EXPORTER_OTLP_ENDPOINT=
READINESS_TIMEOUT_SECONDS=3
WORKER_HEARTBEAT_MAX_AGE_SECONDS=90

# ── Remotion Premium Renderer (Worker service) ────────────────────────────────
# Set REMOTION_ENABLED=true to activate premium rendering (B-roll, music, effects).
# Requires the worker Dockerfile (apps/worker/Dockerfile) which bundles Chromium.
# Leave false (default) to use the FFmpeg caption-only path for all renders.
REMOTION_ENABLED=false

# Path to apps/renderer inside the worker container (set automatically in Dockerfile)
RENDERER_BASE_PATH=/app/apps/renderer

# Chrome path for headless rendering (set automatically in Dockerfile)
BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# Remotion always starts Chromium with --no-sandbox; there is no setting to
# re-enable it. The worker therefore hands the renderer only an allowlisted
# environment (apps/worker/src/subprocess-env.mjs), never its secrets.
