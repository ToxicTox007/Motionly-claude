# Production worker environment template. Supply values through the deployment secret manager.
export APP_ENV="production"
export PROCESS_ROLE="worker"
export SUPABASE_URL="https://your-project.supabase.co"
# Supabase as browsers reach it; links the worker signs for browsers use it.
export SUPABASE_PUBLIC_URL="https://your-app.example.com/supabase"
export SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
export SUPABASE_JWT_SECRET="replace-with-supabase-jwt-secret"
export REDIS_URL="redis://default:replace-with-password@your-redis.example.com:6379"
export WORKER_API_BASE_URL="https://your-api.example.com"
export WORKER_API_TOKEN="replace-with-distinct-worker-token"
export EXPORT_STORAGE_BUCKET="exports"
export UPLOAD_STORAGE_BUCKET="raw-uploads"
export METRICS_BEARER_TOKEN="replace-with-long-random-metrics-token"
export MODEL_GATEWAY_ENABLED="true"
export MODEL_GATEWAY_MONTHLY_BUDGET_USD="100"
export MODEL_GATEWAY_REQUEST_BUDGET_USD="5"
# Optional per-feature monthly USD caps (JSON); omitted features are uncapped.
# export MODEL_GATEWAY_FEATURE_BUDGETS_USD='{"vision_captions":20,"audio_stems":15}'
# Optional per-plan monthly quotas for remote AI features (defaults in
# app.services.billing.FEATURE_QUOTAS), e.g.:
# export QUOTA_VISION_CAPTIONS_FREE_LIMIT_IMAGES="120"
# export QUOTA_AUDIO_STEMS_CREATOR_LIMIT_SECONDS="3600"
export MODEL_GATEWAY_FAILURE_THRESHOLD="3"
export MODEL_GATEWAY_CIRCUIT_COOLDOWN_SECONDS="60"
# Declarative inference registry (plan Task 4/Task 26). The registry file is the
# only source of inference routes; OpenAI-compatible and Azure endpoints are
# declared there, never as vendor env variables. A comma-separated list composes
# a remote registry with the local fragments (infra/ai-registry/*.json).
export AI_REGISTRY_FILE="/opt/motionly/ai-registry/registry.json"
export AI_BLOCK_NONCOMMERCIAL="false"
export AI_WORKSPACE_SCOPED_ROUTES="false"
export AI_SECRETS_DIR="/run/secrets"
export AI_SECRETS_BUNDLE_FILE="/run/secrets/ai_secrets_bundle"
export AI_QUOTA_SCOPE="feature"
# The transcription and planning model ids/revisions, credentials and provider
# labels all come from the registry (the gateway route's provider, or a neutral
# "gateway" label); only the budget hints stay as settings.
export TRANSCRIPTION_ESTIMATED_COST_PER_REQUEST_USD="0.25"
export EDIT_PLANNER_INPUT_COST_PER_MILLION_USD="2"
export EDIT_PLANNER_OUTPUT_COST_PER_MILLION_USD="2"
export AUDIO_ML_PROVIDER="local_ml"
# Remote speaker diarization is configured through an audio.diarization registry
# route (plan Task 17), not an env switch. AUDIO_DIARIZATION_PROVIDER selects
# only local_ml or disabled.
# export AUDIO_DIARIZATION_PROVIDER="local_ml"
# Remote voice emotion is rebuilt as a registry capability route in Tier 2 (plan
# Task 12); there is no vendor voice-emotion env setting.
# CPU sound events in the cpu-vision image (optional; default follows AUDIO_ML_PROVIDER).
# export AUDIO_SOUND_PROVIDER="yamnet_tflite"
# CPU background matte on the cpu-vision worker (optional; default local_ml on GPU).
# export MATTE_PROVIDER="local_cpu"
# GPU-free deployment (infra/docker-compose.remote-ai.yml sets it): every feature
# must then use a CPU or remote provider.
# export GPU_WORKERS_ENABLED="false"
# GPU-free visual analysis on the cpu-vision worker (optional; default local_ml on GPU).
# export VISUAL_PROVIDER="remote"
# export VISUAL_REMOTE_MAX_KEYFRAMES="24"
# Remote keyframe object detection is configured through a vision.object_detection
# registry route (plan Task 17), not an env switch; the route supplies the key
# and per-image price.
# Remote keyframe captions are rebuilt as a registry capability route in Tier 2
# (plan Task 11); there is no vendor caption env setting.
# Keyframe embeddings become a registry capability route in Tier 2 (plan Task
# 12); there is no vendor embeddings env setting.
export ALLOW_FIXTURE_PROVIDERS="false"

# Editorial learning stays disabled until consent, governance RPCs, and shadow review are verified.
export EDITORIAL_LEARNING_ENABLED="false"
export EDITORIAL_LEARNING_RETENTION_DAYS="90"
export EDITORIAL_LEARNING_MINIMUM_EXAMPLES="100"
export EDITORIAL_LEARNING_SHADOW_SAMPLE_RATE="0"

# Non-model providers checked by the same production startup guard
export STEM_SEPARATION_PROVIDER="demucs"
export MUSIC_PROVIDER="licensed_catalog"
export STOCK_VIDEO_PROVIDER="pexels_pixabay"
export PEXELS_API_KEY="replace-with-pexels-api-key"
export PIXABAY_API_KEY="replace-with-pixabay-api-key"
# Text/image embeddings become a registry capability route in Tier 2 (plan Task
# 12); there is no vendor embeddings env setting. B-roll ranking uses local CLIP
# or its lexical fallback until a route is configured.
# A remote stem-separation provider is configured through an audio.stem_separation
# registry route (plan Task 17), not an env switch; the default is local Demucs.
export PYTHON_EXECUTOR_REQUEST_TIMEOUT_MS="900000"
export PYTHON_EXECUTOR_HEARTBEAT_TIMEOUT_MS="120000"
export PYTHON_EXECUTOR_HEARTBEAT_INTERVAL_MS="30000"
export ML_WORKER_ENABLED="true"
export MODEL_PREFETCH="true"
export WORKER_QUEUES="visual_analysis"
export WORKER_CONCURRENCY="1"
export VISUAL_ANALYSIS_WORKER_CONCURRENCY="1"

# Local model ids and revisions come from the registry local routes
# (infra/ai-registry/cpu-local.json, gpu-local.json), not env settings (Task 14).

# Durable orchestration role overrides. Set PROCESS_ROLE to temporal-worker for
# the Temporal worker service; dispatcher/reconciler use externally managed Temporal.
# TEMPORAL_API_KEY must come from the deployment secret manager.
export TEMPORAL_ADDRESS="your-namespace.tmprl.cloud:7233"
export TEMPORAL_NAMESPACE="your-namespace.your-account"
export TEMPORAL_API_KEY="replace-with-temporal-api-key"
export TEMPORAL_TASK_QUEUE="motionly-workflows"
export TEMPORAL_TLS_ENABLED="true"
export WORKFLOW_DISPATCHER_BATCH_SIZE="25"
export WORKFLOW_DISPATCHER_LEASE_SECONDS="60"
export WORKFLOW_DISPATCHER_POLL_INTERVAL_SECONDS="1"
export WORKFLOW_DISPATCHER_BACKOFF_INITIAL_SECONDS="1"
export WORKFLOW_DISPATCHER_BACKOFF_MAX_SECONDS="60"
export WORKFLOW_RECONCILER_INTERVAL_SECONDS="30"
export WORKFLOW_RECONCILER_STALENESS_SECONDS="300"
export WORKFLOW_RECONCILER_BATCH_SIZE="50"
export WORKFLOW_STEP_LEASE_SECONDS="3600"
export WORKFLOW_STEP_RESULT_MAX_BYTES="262144"
