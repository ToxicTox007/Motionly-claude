# Production worker environment template. Supply values through the deployment secret manager.
export APP_ENV="production"
export PROCESS_ROLE="worker"
export SUPABASE_URL="https://your-project.supabase.co"
export SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
export SUPABASE_JWT_SECRET="replace-with-supabase-jwt-secret"
export REDIS_URL="redis://default:replace-with-password@your-redis.example.com:6379"
export WORKER_API_BASE_URL="https://your-api.example.com"
export WORKER_API_TOKEN="replace-with-distinct-worker-token"
export EXPORT_STORAGE_BUCKET="exports"
export UPLOAD_STORAGE_BUCKET="raw-uploads"
export RENDER_EXECUTE_FFMPEG="true"
export PUBLISH_TOKEN_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
export METRICS_BEARER_TOKEN="replace-with-long-random-metrics-token"
export SENTRY_DSN="replace-with-sentry-dsn"
export MODEL_GATEWAY_ENABLED="true"
export MODEL_GATEWAY_MONTHLY_BUDGET_USD="100"
export MODEL_GATEWAY_REQUEST_BUDGET_USD="5"
export MODEL_GATEWAY_FAILURE_THRESHOLD="3"
export MODEL_GATEWAY_CIRCUIT_COOLDOWN_SECONDS="60"
export GROQ_API_KEY="replace-with-groq-api-key"
export TRANSCRIPTION_PROVIDER="groq"
export TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
export TRANSCRIPTION_MODEL_REVISION="whisper-large-v3-turbo-2025-02-01"
export TRANSCRIPTION_ESTIMATED_COST_PER_REQUEST_USD="0.25"
export OPENROUTER_API_KEY="replace-with-openrouter-api-key"
export EDIT_PLANNER_PROVIDER="openrouter"
export EDIT_PLANNER_MODEL="openai/gpt-4.1-mini"
export EDIT_PLANNER_MODEL_REVISION="openai/gpt-4.1-mini-2025-04-14"
export EDIT_PLANNER_INPUT_COST_PER_MILLION_USD="2"
export EDIT_PLANNER_OUTPUT_COST_PER_MILLION_USD="2"
export AUDIO_ML_PROVIDER="local_ml"
export ALLOW_FIXTURE_PROVIDERS="false"

# Editorial learning stays disabled until consent, governance RPCs, and shadow review are verified.
export EDITORIAL_LEARNING_ENABLED="false"
export EDITORIAL_LEARNING_RETENTION_DAYS="90"
export EDITORIAL_LEARNING_MINIMUM_EXAMPLES="100"
export EDITORIAL_LEARNING_SHADOW_SAMPLE_RATE="0"

# Keep disabled until the performance-feedback policy and platform integrations are approved.
export PERFORMANCE_FEEDBACK_ENABLED="false"
export PERFORMANCE_FEEDBACK_POLICY_VERSION="performance-feedback/v1"
export PERFORMANCE_FEEDBACK_RETENTION_DAYS="90"
export PERFORMANCE_FEEDBACK_MINIMUM_EXAMPLES="3"
export RUNWAY_API_KEY="replace-with-runway-api-key"
export RUNWAY_MODEL="gen3a_turbo"
export RUNWAY_MODEL_REVISION="gen3a_turbo-2024-11-06"
export RUNWAY_ESTIMATED_COST_PER_REQUEST_USD="0.5"

# Non-model providers checked by the same production startup guard
export STEM_SEPARATION_PROVIDER="demucs"
export MUSIC_PROVIDER="licensed_catalog"
export STOCK_VIDEO_PROVIDER="pexels_pixabay"
export PEXELS_API_KEY="replace-with-pexels-api-key"
export PIXABAY_API_KEY="replace-with-pixabay-api-key"
export PYTHON_EXECUTOR_REQUEST_TIMEOUT_MS="900000"
export PYTHON_EXECUTOR_HEARTBEAT_TIMEOUT_MS="120000"
export PYTHON_EXECUTOR_HEARTBEAT_INTERVAL_MS="30000"
export ML_WORKER_ENABLED="true"
export MODEL_PREFETCH="true"
export WORKER_QUEUES="visual_analysis"
export WORKER_CONCURRENCY="1"
export VISUAL_ANALYSIS_WORKER_CONCURRENCY="1"

# Immutable local model revisions (commit/tag pins)
export PYANNOTE_MODEL_REVISION="84fd25912480287da0247647c3d2b4853cb3ee5d"
export WAV2VEC_EMOTION_MODEL_REVISION="441a7599c3b22107314dcbd9166621c5c83f2cc5"
export VISUAL_CLIP_MODEL_REVISION="3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268"
export VISUAL_BLIP_MODEL_REVISION="59a1ef6c1e5117b3f65523d1c6066825bcf315e3"
