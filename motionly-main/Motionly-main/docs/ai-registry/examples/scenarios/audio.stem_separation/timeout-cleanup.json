{
  "registry": "stem-separation.json",
  "route_id": "audio-stems-remote",
  "capability": "audio.stem_separation",
  "differential": false,
  "differential_skip_reason": "Post-commit timeout is marked non-fallback by the ported async_job adapter (plan Section 2.5 sent-discipline). The archived separator left fallback_eligible unset (can_fallback=true), so the error class legitimately differs on this one dimension; the request sequence and cleanup are identical. Differential parity for the timeout path is otherwise covered by the matching request shapes.",
  "request": {
    "type": "stem_separation",
    "source": { "b64": "c291cmNlLW1lZGlh" },
    "model": "htdemucs",
    "duration_s": 1
  },
  "exchanges": [
    {
      "match": { "method": "POST", "path": "/api/v1/upload/" },
      "response": {
        "status": 200,
        "json": { "id": "2fe8f214-1771-4900-9e7e-570f823bd359" }
      }
    },
    {
      "match": { "method": "POST", "path": "/api/v1/split/stem_separator/" },
      "response": {
        "status": 200,
        "json": { "task_id": "8cad7e3d-a5a3-4e79-9463-59cd4da16977" }
      }
    },
    {
      "match": { "method": "POST", "path": "/api/v1/check/" },
      "repeat": "always",
      "response": {
        "status": 200,
        "json": {
          "result": {
            "8cad7e3d-a5a3-4e79-9463-59cd4da16977": {
              "status": "progress",
              "progress": 1
            }
          }
        }
      }
    },
    {
      "match": { "method": "POST", "path": "/api/v1/delete/" },
      "response": { "status": 200, "json": { "status": "success" } }
    }
  ],
  "expect": {
    "error": { "code": "provider_timeout" },
    "cleanup": [
      {
        "method": "POST",
        "path": "/api/v1/delete/",
        "body_keys": ["source_id"]
      }
    ]
  }
}
