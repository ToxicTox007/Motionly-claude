{
  "version": 1,
  "adapters": [
    {
      "id": "vision-objects-alt-endpoint",
      "type": "generic_http",
      "base_url": "https://detect.example.net/api",
      "network": "public",
      "auth": {
        "type": "bearer",
        "secret_ref": "bundle:vision-objects-alt-endpoint"
      },
      "timeout_s": 45,
      "data_processor": {
        "display_name": "Example Detection Cloud",
        "purpose": "Receives still frames from your video to recognise objects. The provider states frames are processed in memory and not retained.",
        "data_categories": ["image"],
        "policy_url": "https://detect.example.net/privacy"
      }
    },
    {
      "id": "base-llm-endpoint",
      "type": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "network": "public",
      "auth": { "type": "bearer", "secret_ref": "bundle:base-llm-endpoint" },
      "timeout_s": 60,
      "data_processor": {
        "display_name": "OpenAI",
        "purpose": "Planning chat and speech-to-text transcription so this example validates as a complete, required-capability-satisfying registry.",
        "data_categories": ["text", "audio"],
        "policy_url": "https://openai.com/policies/privacy-policy"
      }
    }
  ],
  "models": [
    {
      "id": "vision-objects-alt-model",
      "model_id": "example-detector-xl",
      "revision": "2026-09-30",
      "licence": "proprietary",
      "commercial_use": true,
      "capabilities": ["vision.object_detection"]
    },
    {
      "id": "base-llm-model",
      "model_id": "gpt-4o-mini",
      "revision": "2026-10-01",
      "licence": "proprietary",
      "commercial_use": true,
      "capabilities": ["planning.chat", "transcription.speech_to_text"]
    }
  ],
  "routes": [
    {
      "id": "planning-chat-remote",
      "capability": "planning.chat",
      "adapter_id": "base-llm-endpoint",
      "model_id": "gpt-4o-mini",
      "model_ref": "base-llm-model",
      "model_revision": "2026-10-01",
      "pricing": {
        "status": "priced",
        "unit": "tokens",
        "input_per_million_usd": 0.15,
        "output_per_million_usd": 0.6
      },
      "budget": { "feature": "planning", "monthly_usd": 50 },
      "compute_requirement": "remote",
      "enabled": true,
      "scope": "global"
    },
    {
      "id": "speech-to-text-remote",
      "capability": "transcription.speech_to_text",
      "adapter_id": "base-llm-endpoint",
      "model_id": "gpt-4o-mini",
      "model_ref": "base-llm-model",
      "model_revision": "2026-10-01",
      "pricing": {
        "status": "priced",
        "unit": "seconds",
        "per_unit_usd": 0.0001
      },
      "budget": { "feature": "transcription", "monthly_usd": 50 },
      "compute_requirement": "remote",
      "enabled": true,
      "scope": "global"
    },
    {
      "id": "vision-objects-alt-remote",
      "capability": "vision.object_detection",
      "adapter_id": "vision-objects-alt-endpoint",
      "model_id": "example-detector-xl",
      "model_ref": "vision-objects-alt-model",
      "model_revision": "2026-09-30",
      "priority": 100,
      "pricing": {
        "status": "priced",
        "unit": "images",
        "per_request_usd": 0.001
      },
      "budget": {
        "feature": "vision_objects",
        "monthly_usd": 25,
        "hard_cap": { "max_requests_per_month": 5000 }
      },
      "compute_requirement": "remote",
      "limits": { "max_batch": 8, "max_request_bytes": 6291456 },
      "enabled": true,
      "scope": "global",
      "label_aliases": { "automobile": "car", "cellphone": "cell phone" },
      "mapping": {
        "request": {
          "method": "POST",
          "path": "/v2/detect",
          "body": {
            "frames": {
              "$map": {
                "over": "input.images",
                "each": {
                  "data_uri": {
                    "$fn": "data_url",
                    "args": [{ "$ref": "item" }]
                  }
                }
              }
            },
            "top_k": { "$ref": "input.max_results" }
          }
        },
        "items": "response.images",
        "aligned_to_input": true,
        "fields": {
          "detections": "objects",
          "label": "class_name",
          "score": "prob",
          "box": "bbox"
        },
        "box_format": "xywh_norm",
        "item_error": "status",
        "item_error_codes": {
          "invalid_image": "rejected",
          "server_error": "unavailable"
        },
        "error_map": {
          "400": "rejected",
          "401": "auth",
          "402": "quota",
          "429": "quota",
          "500": "unavailable",
          "503": "unavailable"
        },
        "usage": "count_ok_items"
      }
    }
  ]
}
