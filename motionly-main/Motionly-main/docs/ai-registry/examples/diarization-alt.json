{
  "version": 1,
  "adapters": [
    {
      "id": "audio-diarization-alt-endpoint",
      "type": "async_job",
      "base_url": "https://diarize.example.invalid/api",
      "network": "public",
      "auth": {
        "type": "custom_header",
        "header_name": "x-api-key",
        "secret_ref": "bundle:audio-diarization-alt-endpoint"
      },
      "timeout_s": 60,
      "data_processor": {
        "display_name": "Example Speaker Labs",
        "purpose": "A second, differently shaped diarization API: the audio is uploaded directly to a job path and the job is polled with a POST request keyed by the job id in the body.",
        "data_categories": ["audio"],
        "policy_url": "https://diarize.example.invalid/privacy"
      }
    },
    {
      "id": "base-chat-endpoint",
      "type": "openai_compatible",
      "base_url": "https://api.example.invalid/v1",
      "network": "public",
      "auth": { "type": "bearer", "secret_ref": "bundle:base-chat-endpoint" },
      "timeout_s": 60,
      "data_processor": {
        "display_name": "Example Inference",
        "purpose": "Planning and transcription for the required startup capabilities.",
        "data_categories": ["text", "audio"],
        "policy_url": "https://example.invalid/privacy"
      }
    }
  ],
  "models": [
    {
      "id": "audio-diarization-alt-model",
      "model_id": "diarize-standard",
      "revision": "2026-02-01",
      "licence": "proprietary",
      "commercial_use": true,
      "capabilities": ["audio.diarization"]
    },
    {
      "id": "base-chat-model",
      "model_id": "chat-small",
      "revision": "2026-01-01",
      "licence": "proprietary",
      "commercial_use": true,
      "capabilities": ["planning.chat"]
    },
    {
      "id": "base-stt-model",
      "model_id": "stt-small",
      "revision": "2026-01-01",
      "licence": "proprietary",
      "commercial_use": true,
      "capabilities": ["transcription.speech_to_text"]
    }
  ],
  "routes": [
    {
      "id": "audio-diarization-alt-remote",
      "capability": "audio.diarization",
      "adapter_id": "audio-diarization-alt-endpoint",
      "model_id": "diarize-standard",
      "model_ref": "audio-diarization-alt-model",
      "model_revision": "2026-02-01",
      "priority": 20,
      "strategy": "async_job",
      "pricing": {
        "status": "priced",
        "unit": "seconds",
        "input_per_million_usd": 400.0,
        "minimum_billable_units": 10
      },
      "budget": {
        "feature": "audio_diarization",
        "monthly_usd": 50
      },
      "compute_requirement": "remote",
      "enabled": true,
      "scope": "global",
      "upload_filename": "speech.wav",
      "mapping": {
        "steps": [
          {
            "method": "POST",
            "path": "/jobs",
            "body": { "format": "wav" },
            "capture": { "job_id": "response.id" },
            "commit": true
          },
          {
            "method": "PUT",
            "path": "/jobs/{vars.job_id}/audio",
            "body": "input.file"
          }
        ],
        "poll": {
          "method": "POST",
          "path": "/status",
          "body": { "job": { "$ref": "vars.job_id" } },
          "status": "response.state",
          "status_map": {
            "queued": { "state": "running" },
            "processing": { "state": "running" },
            "done": { "state": "succeeded" },
            "error": { "state": "failed", "billable": false, "fallback": false }
          },
          "tolerate_retryable": true,
          "interval_s": 5,
          "backoff": { "factor": 1.5, "max_interval_s": 30 },
          "max_wait_s": 900
        },
        "result": {
          "items": "response.segments",
          "fields": {
            "speaker": "label",
            "start_ms": { "$fn": "to_ms", "args": [{ "$ref": "item.from_s" }] },
            "end_ms": { "$fn": "to_ms", "args": [{ "$ref": "item.to_s" }] }
          }
        }
      }
    },
    {
      "id": "base-planning",
      "capability": "planning.chat",
      "adapter_id": "base-chat-endpoint",
      "model_id": "chat-small",
      "model_ref": "base-chat-model",
      "model_revision": "2026-01-01",
      "priority": 10,
      "pricing": {
        "status": "priced",
        "input_per_million_usd": 1.0,
        "output_per_million_usd": 2.0
      },
      "budget": { "feature": "planning" },
      "compute_requirement": "remote"
    },
    {
      "id": "base-transcription",
      "capability": "transcription.speech_to_text",
      "adapter_id": "base-chat-endpoint",
      "model_id": "stt-small",
      "model_ref": "base-stt-model",
      "model_revision": "2026-01-01",
      "priority": 10,
      "pricing": { "status": "priced", "input_per_million_usd": 1.0 },
      "budget": { "feature": "transcription" },
      "compute_requirement": "remote"
    }
  ]
}
