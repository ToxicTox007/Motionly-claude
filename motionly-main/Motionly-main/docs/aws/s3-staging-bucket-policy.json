{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEveryPrincipalExceptInferenceUserAndBreakGlass",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<STAGING_BUCKET>",
        "arn:aws:s3:::<STAGING_BUCKET>/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::<ACCOUNT_ID>:user/motionly-inference",
            "arn:aws:iam::<ACCOUNT_ID>:role/<BREAK_GLASS_ROLE_NAME>"
          ]
        }
      }
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<STAGING_BUCKET>",
        "arn:aws:s3:::<STAGING_BUCKET>/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
