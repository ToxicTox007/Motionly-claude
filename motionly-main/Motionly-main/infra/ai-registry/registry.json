{
  "version": 1,
  "adapters": [
    {
      "id": "bedrock-converse",
      "type": "aws_bedrock",
      "network": "public",
      "auth": {
        "type": "aws_access_key",
        "access_key_id_ref": "file:aws_inference_access_key_id",
        "secret_ref": "file:aws_inference_secret_access_key"
      },
      "timeout_s": 60,
      "config": {
        "region": "ap-south-1",
        "api": "converse"
      },
      "data_processor": {
        "display_name": "Amazon Bedrock (Converse)",
        "purpose": "Serves planning chat, object detection and image captions through the Bedrock Converse API using cross-region (APAC) inference profiles from the source region ap-south-1 (Nova Pro for planning, Nova Lite for vision). Requests and results may be processed in any APAC region of the profile (ap-northeast-1, ap-northeast-2, ap-northeast-3, ap-south-1, ap-southeast-1, ap-southeast-2). Data sent between regions stays on the AWS network and is encrypted in transit; CloudTrail in ap-south-1 records the region that processed each request. Credentials come from a narrowly scoped IAM user's static access key mounted as secret files. Amazon states Bedrock does not retain inputs or outputs and does not use them to train models.",
        "data_categories": ["text", "image"],
        "policy_url": "https://docs.aws.amazon.com/bedrock/latest/userguide/data-protection.html"
      }
    },
    {
      "id": "bedrock-embeddings",
      "type": "aws_bedrock",
      "network": "public",
      "auth": {
        "type": "aws_access_key",
        "access_key_id_ref": "file:aws_inference_access_key_id",
        "secret_ref": "file:aws_inference_secret_access_key"
      },
      "timeout_s": 60,
      "config": {
        "region": "ap-south-1",
        "api": "invoke_model",
        "embedding_family": "titan"
      },
      "data_processor": {
        "display_name": "Amazon Bedrock (Titan Text Embeddings, InvokeModel)",
        "purpose": "Produces text embeddings through the Bedrock InvokeModel API in ap-south-1 (Amazon Titan Text Embeddings V2). This is an in-region call: requests, results and your data are processed and stored only in ap-south-1 and do not leave that region. Credentials come from a narrowly scoped IAM user's static access key mounted as secret files. Amazon states Bedrock does not retain inputs or outputs and does not use them to train models.",
        "data_categories": ["text"],
        "policy_url": "https://docs.aws.amazon.com/bedrock/latest/userguide/data-protection.html"
      }
    },
    {
      "id": "bedrock-data-automation",
      "type": "aws_bedrock",
      "network": "public",
      "auth": {
        "type": "aws_access_key",
        "access_key_id_ref": "file:aws_inference_access_key_id",
        "secret_ref": "file:aws_inference_secret_access_key"
      },
      "timeout_s": 900,
      "config": {
        "region": "ap-south-1",
        "api": "data_automation",
        "s3_bucket": "motionly-staging-bda-576971911060",
        "s3_prefix": "bda",
        "s3_region": "ap-south-1",
        "data_automation_profile_arn": "arn:aws:bedrock:ap-south-1:576971911060:data-automation-profile/apac.data-automation-v1",
        "data_automation_project_arn": "arn:aws:bedrock:ap-south-1:576971911060:data-automation-project/a4b157e9b58c",
        "data_automation_stage": "LIVE",
        "max_wait_s": 900,
        "poll_interval_s": 5,
        "cleanup": true
      },
      "data_processor": {
        "display_name": "Amazon Bedrock Data Automation",
        "purpose": "Transcribes and diarizes audio through Bedrock Data Automation using the cross-region (APAC) data-automation profile from the source region ap-south-1. Requests and results may be processed in any APAC region of the profile (ap-northeast-1, ap-northeast-2, ap-northeast-3, ap-south-1, ap-south-2, ap-southeast-1, ap-southeast-2, ap-southeast-4); per the AWS cross-region inference documentation your data is only stored in the source region ap-south-1 while requests and results may move within the geography. The audio is staged in an S3 bucket you own in ap-south-1 under the bda/ prefix, processed asynchronously, and the structured output is read back and deleted. Credentials come from a narrowly scoped IAM user's static access key mounted as secret files. Amazon states Bedrock does not retain inputs or outputs and does not use them to train models.",
        "data_categories": ["audio"],
        "policy_url": "https://docs.aws.amazon.com/bedrock/latest/userguide/data-protection.html"
      }
    },
