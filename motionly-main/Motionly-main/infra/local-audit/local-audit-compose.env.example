# Copy this file to a protected path OUTSIDE the repository (0600 on POSIX; an
# owner-only ACL on Windows), then fill every blank value from the matching
# protected secret directory. Do not put real values in this example or commit
# the copied file.
#
# The plan-only check is safe to run before Docker:
#   python apps/api/scripts/audit_local_capabilities.py --plan-only --env-file <protected-env> --probe-gpu
#
# A future runtime command must use all three files, this exact project name,
# and the local-audit profile. Never use an unscoped `down -v` or volume prune.
COMPOSE_PROJECT_NAME=motionly-local-audit
SECRETS_DIR=

# These values are consumed directly by upstream Supabase/Redis images. Keep
# the copied env file protected; application/provider credentials remain in
# SECRETS_DIR and are mounted through existing *_FILE conventions.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only ingress names. Production Motionly domains are rejected by preflight.
APP_DOMAIN=app.audit.localhost
API_DOMAIN=api.audit.localhost
SUPABASE_DOMAIN=supabase.audit.localhost
SENTRY_DSN=

# Development source image tags. The local-audit overlay builds the custom
# Temporal server; admin-tools must still be an operator-approved local image.
MOTIONLY_API_IMAGE=motionly-api:dev
MOTIONLY_WEB_IMAGE=motionly-web:dev
MOTIONLY_CPU_FFMPEG_WORKER_IMAGE=motionly-cpu-ffmpeg-worker:dev
MOTIONLY_GPU_WORKER_IMAGE=motionly-gpu-worker:dev
MOTIONLY_GPU_FFMPEG_WORKER_IMAGE=motionly-gpu-ffmpeg-worker:dev
MOTIONLY_DEMUCS_WORKER_IMAGE=motionly-demucs-worker:dev
MOTIONLY_PROVIDER_WORKER_IMAGE=motionly-provider-worker:dev
MOTIONLY_PLANNING_WORKER_IMAGE=motionly-planning-worker:dev
MOTIONLY_REMOTION_WORKER_IMAGE=motionly-remotion-worker:dev
MOTIONLY_PUBLISHING_WORKER_IMAGE=motionly-publishing-worker:dev
MOTIONLY_TEMPORAL_SERVER_IMAGE=motionly-temporal-server:local-audit
TEMPORAL_ADMIN_TOOLS_IMAGE=
TEMPORAL_BOOTSTRAP_ADMIN_UNTIL=

# Full local-audit topology includes NVIDIA workers. The plan-only report is
# intentionally not ready until --probe-gpu validates host/container access.
LOCAL_AUDIT_REQUIRE_GPU=true
LOCAL_AUDIT_MIN_FREE_DISK_GB=30
LOCAL_AUDIT_MIN_MEMORY_GB=16

# Live effects remain denied unless an operator explicitly sets true AFTER the
# remaining sandbox-only controls validate. Account IDs must contain a clear
# non-production label such as -audit, -sandbox, -staging, -test, or -dev.
LOCAL_AUDIT_MODE=true
LOCAL_AUDIT_EXTERNAL_EFFECTS_ENABLED=false
LOCAL_AUDIT_TARGET=local-sandbox
LOCAL_AUDIT_RUN_ID=
LOCAL_AUDIT_PROVIDER_ACCOUNTS=
LOCAL_AUDIT_PUBLISHING_ACCOUNTS=
LOCAL_AUDIT_APPROVED_DOMAINS=
LOCAL_AUDIT_ALLOWED_PUBLISH_VISIBILITIES=private,unlisted
LOCAL_AUDIT_MAX_PER_RUN_SPEND_USD=
LOCAL_AUDIT_MAX_TOTAL_SPEND_USD=
LOCAL_AUDIT_REMOTE_CLEANUP_OWNER=
LOCAL_AUDIT_REMOTE_CLEANUP_REFERENCE=
LOCAL_AUDIT_REMOTE_CLEANUP_POLICY=
