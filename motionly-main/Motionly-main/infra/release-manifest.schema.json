{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionly.invalid/schemas/release-manifest-v2.json",
  "title": "Motionly immutable archive-bound release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "revision",
    "created_at",
    "compose_file",
    "images",
    "sboms",
    "bundle"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "release_id": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "compose_file": { "const": "infra/docker-compose.gpu.yml" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MOTIONLY_API_IMAGE",
        "MOTIONLY_WEB_IMAGE",
        "MOTIONLY_CPU_FFMPEG_WORKER_IMAGE",
        "MOTIONLY_GPU_WORKER_IMAGE",
        "MOTIONLY_GPU_FFMPEG_WORKER_IMAGE",
        "MOTIONLY_DEMUCS_WORKER_IMAGE",
        "MOTIONLY_PROVIDER_WORKER_IMAGE",
        "MOTIONLY_PLANNING_WORKER_IMAGE",
        "MOTIONLY_REMOTION_WORKER_IMAGE",
        "MOTIONLY_TEMPORAL_SERVER_IMAGE"
      ],
      "properties": {
        "MOTIONLY_API_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_WEB_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_CPU_FFMPEG_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_GPU_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_GPU_FFMPEG_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_DEMUCS_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_PROVIDER_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_PLANNING_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_REMOTION_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_TEMPORAL_SERVER_IMAGE": { "$ref": "#/$defs/digestImage" },
        "MOTIONLY_CPU_VISION_WORKER_IMAGE": { "$ref": "#/$defs/digestImage" }
      }
    },
    "sboms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "web",
        "cpu-worker",
        "gpu-worker",
        "demucs-worker",
        "remotion-worker",
        "temporal-server"
      ],
      "properties": {
        "api": { "$ref": "#/$defs/sbomArtifact" },
        "web": { "$ref": "#/$defs/sbomArtifact" },
        "cpu-worker": { "$ref": "#/$defs/sbomArtifact" },
        "gpu-worker": { "$ref": "#/$defs/sbomArtifact" },
        "demucs-worker": { "$ref": "#/$defs/sbomArtifact" },
        "remotion-worker": { "$ref": "#/$defs/sbomArtifact" },
        "temporal-server": { "$ref": "#/$defs/sbomArtifact" },
        "cpu-vision-worker": { "$ref": "#/$defs/sbomArtifact" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes", "files"],
      "properties": {
        "name": { "const": "release-bundle.tar.gz" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bundleFile" }
        }
      }
    }
  },
  "$defs": {
    "digestImage": {
      "type": "string",
      "pattern": "^ghcr\\.io/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sbomArtifact": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.spdx\\.json$"
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "mode"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 }
      }
    }
  }
}
