# Production origin behind CloudFront (infra/aws/edge-contract.json): plain
# HTTP on port 80 for the distribution's domain (CloudFront forwards the viewer
# Host), so Caddy requests no certificate. The origin guard refuses everything
# that did not come through the distribution; the shared routes split by path.
http://{$APP_DOMAIN} {
	import /etc/caddy/origin-guard.caddy
	import /etc/caddy/routes.caddy
}
