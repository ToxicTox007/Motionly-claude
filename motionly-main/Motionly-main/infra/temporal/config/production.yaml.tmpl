# Rendered by motionly-temporal-server into a mode-0600 temporary file. The
# only substituted value is the database password read directly from its Docker
# secret; certificate paths stay Docker secret paths and no PEM material is in Git.
log:
  stdout: true
  level: info

persistence:
  defaultStore: postgres-default
  visibilityStore: postgres-visibility
  numHistoryShards: 4
  datastores:
    postgres-default:
      sql:
        pluginName: postgres12
        databaseName: temporal
        connectAddr: temporal-postgres:5432
        connectProtocol: tcp
        user: temporal
        password: {{TEMPORAL_DB_PASSWORD}}
        maxConns: 20
        maxIdleConns: 20
        maxConnLifetime: 1h
    postgres-visibility:
      sql:
        pluginName: postgres12
        databaseName: temporal_visibility
        connectAddr: temporal-postgres:5432
        connectProtocol: tcp
        user: temporal
        password: {{TEMPORAL_DB_PASSWORD}}
        maxConns: 10
        maxIdleConns: 10
        maxConnLifetime: 1h

global:
  membership:
    maxJoinDuration: 30s
    broadcastAddress: temporal
  pprof:
    port: 0
  tls:
    refreshInterval: 5m
    internode:
      server:
        requireClientAuth: true
        certFile: /run/secrets/temporal_internode_cert
        keyFile: /run/secrets/temporal_internode_key
        clientCaFiles:
          - /run/secrets/temporal_ca_cert
      client:
        serverName: temporal
        disableHostVerification: false
        rootCaFiles:
          - /run/secrets/temporal_ca_cert
    frontend:
      server:
        requireClientAuth: true
        certFile: /run/secrets/temporal_server_cert
        keyFile: /run/secrets/temporal_server_key
        clientCaFiles:
          - /run/secrets/temporal_ca_cert
      client:
        serverName: temporal
        disableHostVerification: false
        rootCaFiles:
          - /run/secrets/temporal_ca_cert
    systemWorker:
      certFile: /run/secrets/temporal_internode_cert
      keyFile: /run/secrets/temporal_internode_key
      client:
        serverName: temporal
        disableHostVerification: false
        rootCaFiles:
          - /run/secrets/temporal_ca_cert

services:
  frontend:
    rpc:
      grpcPort: 7233
      membershipPort: 6933
  matching:
    rpc:
      grpcPort: 7235
      membershipPort: 6935
  history:
    rpc:
      grpcPort: 7234
      membershipPort: 6934
  worker:
    rpc:
      grpcPort: 7239
      membershipPort: 6939

clusterMetadata:
  enableGlobalNamespace: false
  failoverVersionIncrement: 10
  masterClusterName: active
  currentClusterName: active
  clusterInformation:
    active:
      enabled: true
      initialFailoverVersion: 1
      rpcName: frontend
      rpcAddress: temporal:7233

dcRedirectionPolicy:
  policy: noop
