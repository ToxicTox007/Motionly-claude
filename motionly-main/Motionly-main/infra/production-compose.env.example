# Production Compose input names only. The host release agent writes the actual
# 0600 environment file after retrieving values from the host secret store. Do
# not put values in this template and do not use tags: image values must be
# name@sha256:digest.
MOTIONLY_API_IMAGE=
MOTIONLY_WEB_IMAGE=
MOTIONLY_CPU_FFMPEG_WORKER_IMAGE=
MOTIONLY_GPU_WORKER_IMAGE=
MOTIONLY_GPU_FFMPEG_WORKER_IMAGE=
MOTIONLY_DEMUCS_WORKER_IMAGE=
MOTIONLY_PROVIDER_WORKER_IMAGE=
MOTIONLY_PLANNING_WORKER_IMAGE=
MOTIONLY_REMOTION_WORKER_IMAGE=
MOTIONLY_TEMPORAL_SERVER_IMAGE=
TEMPORAL_ADMIN_TOOLS_IMAGE=
TEMPORAL_BOOTSTRAP_ADMIN_UNTIL=

# Host-managed directory containing the files named in docs/security/secrets.md.
SECRETS_DIR=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The ingress serves APP_DOMAIN; PUBLIC_ORIGIN is https://<APP_DOMAIN>. Browsers
# reach the API at <origin>/api and Supabase at <origin>/supabase.
APP_DOMAIN=
PUBLIC_ORIGIN=

# Deployment billing posture; one of: disabled, demo. Production requires it.
BILLING_MODE=
# Days a past-due (failed renewal) subscription keeps paid features, counted
# from the end of the paid period (0-60, default 7). After it, Free applies.
BILLING_PAST_DUE_GRACE_DAYS=7

# Declarative inference registry and its one generic secrets bundle (plan Task
# 26): the only source of inference routes. The registry file and the bundle
# file are mounted from the base topology; no vendor endpoint or key is set as
# an env variable here.
AI_REGISTRY_FILE=/opt/motionly/ai-registry/registry.json
AI_SECRETS_BUNDLE_FILE=/run/secrets/ai_secrets_bundle

# GPU-free remote AI overlay (infra/docker-compose.remote-ai.yml) only:
# MOTIONLY_CPU_VISION_WORKER_IMAGE=   cpu-vision worker image (name@sha256:digest)
# Remote object detection, diarization and stem separation are configured through
# registry routes (plan Task 17); their prices and keys live in the registry and
# its secrets bundle, not as env variables.
# Optional per-feature switches and queue lists (defaults in the overlay), e.g.
# VISUAL_PROVIDER=, GPU_WORKERS_ENABLED=, CPU_VISION_WORKER_QUEUES=,
# GPU_INFERENCE_WORKER_QUEUES=, MODEL_GATEWAY_FEATURE_BUDGETS_USD=
