# Non-secret configuration for /etc/motionly/host.env (mode 0600, root-owned).
# The instance role (infra/aws) reads releases from S3 and secrets from SSM
# Parameter Store under /motionly/<MOTIONLY_ENVIRONMENT>/. Do not put secret
# values, tokens or keys in this file.
MOTIONLY_RELEASE_ROOT=/srv/motionly/releases
MOTIONLY_AGENT_ROOT=/opt/motionly/agent
# production or staging (rehearsal is used only by the local release rehearsal).
MOTIONLY_ENVIRONMENT=production
MOTIONLY_AWS_REGION=ap-south-1
# The stack's ReleasesBucketName output.
MOTIONLY_RELEASE_BUCKET=
# gpu (g6.12xlarge) or cpu: must match the stack's ComputeProfile.
MOTIONLY_COMPUTE_PROFILE=gpu
MOTIONLY_REGISTRY=ghcr.io
# The registry user; its read token is the SSM parameter registry-read-token.
MOTIONLY_REGISTRY_USERNAME=
# The one public host, the CloudFront domain from the stack's PublicOrigin
# output (for example d111111abcdef8.cloudfront.net): /api and /supabase are routed on it.
MOTIONLY_APP_DOMAIN=
# Deployment billing posture; one of: disabled, demo. Required (no default).
MOTIONLY_BILLING_MODE=
MOTIONLY_COSIGN_IDENTITY_REGEXP=^https://github.com/[^/]+/[^/]+/.github/workflows/supply-chain.yml@refs/tags/v.*$
# Optional endpoint of the Azure OpenAI model provider.
MOTIONLY_AZURE_OPENAI_ENDPOINT=
# The custom server image is manifest-bound; only the upstream admin-tools digest is host-configured.
MOTIONLY_TEMPORAL_ADMIN_TOOLS_IMAGE=
# Required for any Temporal security-mode activation; the gate refuses absent proof.
MOTIONLY_TEMPORAL_CANARY_OVERLAP_PROOF_FILE=
# RFC3339, no more than 24 hours ahead when activation is requested.
MOTIONLY_TEMPORAL_BOOTSTRAP_ADMIN_UNTIL=
