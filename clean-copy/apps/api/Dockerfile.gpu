FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    ML_WORKER_ENABLED=true \
    WORKER_QUEUES=visual_analysis
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg nodejs npm libgl1 libglib2.0-0 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api/pyproject.toml ./pyproject.toml
COPY apps/api/app ./app
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/worker/src ./apps/worker/src
RUN cd apps/worker && npm install --omit=dev --no-audit --no-fund \
  && pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu124 \
    "torch>=2.5.0,<2.6" "torchaudio>=2.5.0,<2.6" \
  && pip install --no-cache-dir ".[visual-ml]"
WORKDIR /app/apps/worker
CMD ["node", "src/worker.mjs", "--loop"]
