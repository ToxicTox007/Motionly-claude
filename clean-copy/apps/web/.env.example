# Motionly web environment
NEXT_PUBLIC_APP_URL=https://your-app.example.com
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
# Alias supported for Railway/Render dashboards that already use this name.
# NEXT_PUBLIC_API_URL=https://your-api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_SENTRY_DSN=

# Web server runtime
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SENTRY_DSN=replace-with-sentry-dsn
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=https://app.glitchtip.com
ADMIN_API_TOKEN=replace-with-worker-and-admin-token
ADMIN_USER_IDS=
ADMIN_WORKSPACE_IDS=
